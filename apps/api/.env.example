GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional in local development; required in production.
MONGODB_URI=
MONGODB_DATABASE=agent_lab
# Comma-separated browser origins are supported for localhost and LAN testing.
WEB_ORIGIN=http://localhost:3000
AUTHORIZED_PARTIES=http://localhost:3000
AUTH_REQUIRED=false
# Set to production only on deployment; production requires AUTH_REQUIRED=true.
ENVIRONMENT=development
CLERK_ISSUER=
CLERK_JWKS_URL=
# In production this must be the mount path of a persistent volume, not a container temp directory.
WORKSPACE_ROOT=
VERIFICATION_ALLOW_DEPENDENCY_NETWORK=false
